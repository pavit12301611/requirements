# ReqForge configuration — copy to `.env` and adjust.
# Values already set in the environment always win over this file.

# Admin login (defaults: pavit / 5161211)
ADMIN_USERNAME=pavit
ADMIN_PASSWORD=5161211

# Secret used to sign admin session cookies. Optional — when unset it is
# derived from the admin credentials, so changing the credentials also
# invalidates every session. Set it explicitly to keep sessions valid across
# credential rotations (and set the same value on every deployed instance).
# SESSION_SECRET=some-long-random-string

# Optional settings
PORT=3000
# DATA_DIR=/path/to/persistent/data   # where requirements.db is stored
